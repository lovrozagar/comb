{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"extends": ["./oxlint.base.json"],
	"plugins": ["typescript", "unicorn", "oxc"],
	"jsPlugins": [{ "name": "comb", "specifier": "./packages/core/lint/index.js" }],
	"env": {
		"node": true
	},
	"ignorePatterns": [
		"dist/**",
		"coverage/**",
		"**/.wrangler/**",
		"**/.comb/**",
		"**/.cache/**",
		"**/_gen/**",
		"**/*.gen.ts",
		"**/drizzle/**",
		".agents/**",
		".claude/**",
		".codex/**",
		".gemini/**",
		".grok/**",
		".rulesync/**"
	],
	"categories": {
		"correctness": "error",
		"suspicious": "error"
	},
	"rules": {
		"no-unused-vars": "error",
		"unicorn/no-array-sort": "off",
		"unicorn/prefer-string-starts-ends-with": "error",
		"unicorn/consistent-function-scoping": "off",
		"typescript/no-extraneous-class": "off",
		"no-underscore-dangle": [
			"error",
			{
				"allow": ["_generated", "_require", "_search", "_total"]
			}
		]
	},
	"overrides": [
		{
			"files": ["**/*.{test,typetest}.ts", "packages/core/tests/**/*.ts"],
			"rules": {
				"typescript/no-explicit-any": "off"
			}
		},
		{
			"files": [
				"packages/core/src/**",
				"packages/core/lint/**",
				"packages/core/tests/integration/**",
				"packages/core/tests/structure/**"
			],
			"plugins": ["typescript", "unicorn", "oxc", "vitest"],
			"rules": {
				"complexity": ["error", 15],
				"max-depth": ["error", 4],
				"max-lines": ["error", 300],
				"max-lines-per-function": ["error", 60],
				"max-params": ["error", 3],
				"unicorn/consistent-function-scoping": "error",
				"vitest/expect-expect": [
					"error",
					{ "assertFunctionNames": ["expect", "expectTypeOf", "assert", "assertType"] }
				],
				"vitest/no-conditional-expect": "error",
				"vitest/no-disabled-tests": "error",
				"vitest/no-focused-tests": "error",
				"comb/boundaries": "error",
				"comb/no-console": "error",
				"comb/no-module-side-effects": "error",
				"comb/no-module-state": "error",
				"comb/no-silent-catch": "error",
				"comb/no-v8-ignore": "error",
				"comb/raw-sql-allowlist": "error"
			}
		},
		{
			"files": ["**/*.test.ts"],
			"rules": {
				"max-lines": ["error", 500]
			}
		}
	]
}
