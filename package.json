{
	"name": "comb-monorepo",
	"version": "0.4.0",
	"private": true,
	"workspaces": {
		"packages": [
			"packages/*"
		],
		"catalog": {
			"@cloudflare/workers-types": "5.20260815.1",
			"@libsql/client": "0.17.4",
			"@noble/ciphers": "2.4.0",
			"@noble/hashes": "2.4.0",
			"@total-typescript/ts-reset": "0.6.1",
			"@types/node": "26.2.0",
			"@types/pg": "8.23.1",
			"@types/pluralize": "0.0.33",
			"@vitest/coverage-v8": "4.1.10",
			"bun-types": "1.3.14",
			"drizzle-kit": "1.0.0-rc.4",
			"drizzle-orm": "1.0.0-rc.4",
			"miniflare": "4.20260708.1",
			"oxc-parser": "0.152.0",
			"pg": "8.23.1",
			"pluralize": "8.0.0",
			"postgres": "3.4.9",
			"ts-morph": "28.0.0",
			"typescript": "7.0.2",
			"vitest": "4.1.10",
			"wrangler": "4.147.0",
			"zod": "4.5.4"
		}
	},
	"type": "module",
	"scripts": {
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"grunt:antigravity": "antigravity --dangerously-skip-permissions",
		"grunt:claude": "claude --dangerously-skip-permissions",
		"grunt:codex": "codex --dangerously-bypass-approvals-and-sandbox",
		"grunt:doctor": "node ./.rulesync/scripts/doctor.mjs",
		"grunt:gemini": "gemini --yolo",
		"grunt:grok": "grok --yolo",
		"grunt:hooks:check": "node .rulesync/scripts/hooks-union.mjs --check",
		"grunt:hooks:union": "node .rulesync/scripts/hooks-union.mjs",
		"grunt:purge:global-mcps": "node .rulesync/scripts/purge-global-mcps.mjs",
		"grunt:purge:global-mcps:apply": "node .rulesync/scripts/purge-global-mcps.mjs --apply",
		"grunt:rulesync:check": "node ./.rulesync/scripts/guarded-roots.mjs check",
		"grunt:rulesync:doctor": "rulesync doctor",
		"grunt:rulesync:generate": "node ./.rulesync/scripts/guarded-roots.mjs generate",
		"grunt:rulesync:watch": "node ./.rulesync/scripts/guarded-roots.mjs watch",
		"grunt:setup": "node ./.rulesync/scripts/setup.mjs",
		"grunt:sync:globals": "node .rulesync/scripts/sync-global-settings.mjs",
		"grunt:sync:globals:apply": "node .rulesync/scripts/sync-global-settings.mjs --apply",
		"grunt:sync:globals:check": "node .rulesync/scripts/check-globals.mjs",
		"grunt:test:e2e": "vitest run -c vitest.e2e.config.ts",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepare": "lefthook install --reset-hooks-path",
		"test": "bun run --filter @lovrozagar/comb test",
		"test:all": "bun run --filter @lovrozagar/comb test:all",
		"test:bun": "bun run --filter @lovrozagar/comb test:bun",
		"test:consumers": "bun run --filter @lovrozagar/comb test:consumers",
		"test:coverage": "bun run --filter @lovrozagar/comb test:coverage",
		"test:e2e": "bun --filter @lovrozagar/comb test:e2e",
		"test:watch": "bun run --filter @lovrozagar/comb test:watch",
		"typecheck": "bun run --filter @lovrozagar/comb type:check",
		"typecheck:strict": "bun run --filter @lovrozagar/comb type:check:strict",
		"verify": "bun scripts/verify.ts"
	},
	"devDependencies": {
		"@clack/prompts": "^0.11.0",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@lovrozagar/grunt": "0.11.0",
		"lefthook": "2.2.2",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"rulesync": "16.17.0",
		"smol-toml": "^1.8.0"
	},
	"packageManager": "bun@1.3.11",
	"standards": {
		"repo": "comb",
		"gates": [
			"typecheck:strict",
			"test:bun",
			"test:e2e",
			"test:consumers"
		]
	}
}
