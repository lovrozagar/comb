#!/usr/bin/env bash
# commit-msg — Conventional Commits gate.
#
# Runs commitlint against .commitlintrc.json when it is installed in this repo,
# and otherwise falls back to the equivalent checks implemented inline, so the
# rule set holds even on a tree with no node_modules.
#
# Bypass once: git commit --no-verify

set -u

msg_file="${1:?commit-msg hook called without a message file}"
repo_root="$(git rev-parse --show-toplevel)"

# Prefer the real linter when the dependency is present.
for bin in "$repo_root/node_modules/.bin/commitlint"; do
	if [ -x "$bin" ]; then
		exec "$bin" --edit "$msg_file"
	fi
done

types="build|chore|ci|config|docs|feat|fix|perf|refactor|revert|style|test"

# Drop comments, the scissors section, and leading blank lines.
cleaned="$(sed -e '/^# ------------------------ >8/,$d' -e '/^#/d' "$msg_file" |
	sed -e '/./,$!d')"

header="$(printf '%s\n' "$cleaned" | head -n 1)"
second="$(printf '%s\n' "$cleaned" | sed -n '2p')"
body_lines="$(printf '%s\n' "$cleaned" | sed -n '2,$p' | grep -c '[^[:space:]]' || true)"

fail() {
	printf '\n✖ commit message rejected: %s\n\n' "$1" >&2
	printf 'Conventional Commits: <type>(<optional scope>)<optional !>: <subject>\n' >&2
	printf '  types    %s\n' "$(printf '%s' "$types" | tr '|' ' ')" >&2
	printf '  subject  lower-case, no trailing period, imperative mood\n' >&2
	printf '  header   at most 100 characters\n' >&2
	printf '  body     separated from the header by one blank line\n\n' >&2
	printf 'Your header:\n  %s\n\n' "$header" >&2
	printf 'Examples:\n' >&2
	printf '  feat(cli): add --watch flag\n' >&2
	printf '  fix: keep the dev cache warm across restarts\n' >&2
	printf '  chore(deps)!: drop node 20 support\n\n' >&2
	exit 1
}

# Merge, revert, fixup and squash commits are generated by git itself.
case "$header" in
	"Merge "* | "Revert "* | "revert: "* | "fixup!"* | "squash!"*) exit 0 ;;
esac

[ -n "$header" ] || fail "the message is empty"

if [ "${#header}" -gt 100 ]; then
	fail "the header is ${#header} characters, the limit is 100"
fi

if ! printf '%s' "$header" | grep -Eq "^($types)(\([a-z0-9./_-]+\))?!?: .+$"; then
	fail "the header does not match <type>(<scope>): <subject>"
fi

subject="${header#*: }"

if printf '%s' "$subject" | grep -Eq '^[A-Z]'; then
	fail "the subject must start lower-case"
fi

case "$subject" in
	*.) fail "the subject must not end with a period" ;;
esac

if [ "$body_lines" -gt 0 ] && [ -n "$second" ]; then
	fail "the body must be separated from the header by a blank line"
fi

exit 0
