{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 120,
	"useTabs": true,
	"semi": false,
	"singleQuote": false,
	"ignorePatterns": [
		"dist/**",
		"coverage/**",
		"**/.wrangler/**",
		"**/.comb/**",
		"**/.cache/**",
		"**/_gen/**",
		"**/*.gen.ts",
		"**/drizzle/**",
		"*.lock",
		/* Agent tooling is generated by its own sync, not comb source. */
		".agents/**",
		".claude/**",
		".codex/**",
		".gemini/**",
		".grok/**",
		".rulesync/**",
		".mcp.json",
	],
}
